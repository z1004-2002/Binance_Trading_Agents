# MODÈLE (NON TESTÉ) : sauvegarde cohérente de la base. Déclenchée chaque jour par orchestre-backup.timer.
[Unit]
Description=ORCHESTRE - sauvegarde de la base

[Service]
Type=oneshot
User=orchestre
WorkingDirectory=/opt/orchestre/orchestre
ExecStart=/opt/orchestre/orchestre/orchestre.sh backup --db var/paper.db --dest backups --keep 14
