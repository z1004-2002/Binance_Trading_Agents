# Copier en .env (jamais versionné). Clés distinctes par environnement (EX-SEC-03).
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
BINANCE_LIVE_API_KEY=
BINANCE_LIVE_API_SECRET=
GROQ_API_KEY=
# Alertes hors machine (Telegram) : créer un bot avec @BotFather, puis lire l'identifiant de conversation.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Tableau de bord local : mot de passe d'accès (obligatoire pour lancer `dashboard`).
DASHBOARD_PASSWORD=
# Assistant LLM (Groq) : choisir le modèle dans la console Groq (aucun identifiant n'est figé dans le code).
GROQ_API_KEY=
GROQ_MODEL=
GROQ_MONTHLY_TOKEN_BUDGET=200000
